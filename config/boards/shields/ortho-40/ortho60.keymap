/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ----------------------------------------------
            // |     Z     |     M     |
            // |     A     |     B     |

            bindings = <
                &kp Z    &kp M
                &kp A    &kp B
            >;
        };
    };
};