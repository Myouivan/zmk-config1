#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
//#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";

            // ----------------------------------------------
            // |    ESC    |     1     |     2     |     3     |     4     |     5     |     6     |     7     |     8     |     9     |     0     |     -     |     =     |
            // |   BCSPC   |    TAB    |     Q     |     W     |     E     |     R     |     T     |     Y     |     U     |     I     |     O     |     P     |    LBC    |
            // |    RBC    |     \     |    CAPS   |     A     |     S     |     D     |     F     |     G     |     H     |     J     |     K     |     L     |     ;     |
            // |     '     |    ENT    |    SFT    |     Z     |     X     |     C     |     V     |     B     |     N     |     M     |    DOT    |    COM    |    SLS    |
            // |   RTSFT   |    UP     |    FN     |   CTRL    |    WIN    |    ALT    |    SPC    |    ALT    |   CTRL    |    LFT    |    DWN    |    RGT    |   EXTRA   |
            // |   RTSFT   |    UP     |    SFT    |   CTRL    |    WIN    |    ALT    |    SPC    |    ALT    |   CTRL    |    LFT    |    DWN    |    RGT    |   EXTRA   |

            bindings = <
                &kp ESC    &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &kp MINUS     &kp EQUAL
                &kp BSPC    &kp TAB    &kp Q    &kp W    &kp E    &kp R    &kp T    &kp Y    &kp U    &kp I    &kp O    &kp P     &kp LBKT
                &kp RBKT    &kp NUBS    &kp CAPS    &kp A    &kp S    &kp D    &kp F    &kp G    &kp H    &kp J    &kp K    &kp L     &kp SEMI
                &kp APOS    &kp ENTER    &mo 1    &kp Z    &kp X    &kp C    &kp V    &kp B    &kp N    &kp M    &kp COMMA    &kp DOT     &kp SLASH
                &kp RSHIFT    &kp UP    &kp LSHIFT    &kp RIGHT    &kp DOWN    &kp LEFT    &kp RCTRL    &kp RALT    &kp SPACE    &kp LALT    &kp LWIN    &kp LCTRL     &kp Z
            >;
        };
    };
};